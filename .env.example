# Resend (envío del formulario de contacto): https://resend.com/api-keys
RESEND_API_KEY=

# Bandeja que recibe los mensajes del formulario
CONTACT_TO_EMAIL=jactive@gmail.com

# Remitente de los emails. Mientras chaiactive.com no esté verificado en Resend,
# déjalo vacío (se usa onboarding@resend.dev). Cuando lo esté:
# RESEND_FROM="Chai Active <hola@chaiactive.com>"
RESEND_FROM=

# Enlace de WhatsApp (formato https://wa.me/34XXXXXXXXX). Vacío = no se muestra WhatsApp.
NEXT_PUBLIC_WHATSAPP_URL=

# Email público que aparece en la web
NEXT_PUBLIC_CONTACT_EMAIL=jactive@gmail.com

# URL canónica (por defecto https://www.chaiactive.com)
NEXT_PUBLIC_SITE_URL=

# Demos interactivas dentro del iPhone/portátil (deben aceptar ?showcase=1 y usar datos ficticios)
NEXT_PUBLIC_KEHAL_DEMO_URL=https://chaiactive-demo.vercel.app/
NEXT_PUBLIC_SCHOOL_DEMO_URL=
